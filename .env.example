# Скопируйте в .env (./install.sh делает это сам) и поменяйте то, что нужно.
# Пустая строка значит «по умолчанию».

# --- Где модели ----------------------------------------------------------------------
# Языковые модели: любой сервер с OpenAI-совместимым API (ollama, vLLM). На арендованном
# сервере ./run.sh box up поднимает ollama и пробрасывает её сюда туннелем.
REELSMITH_LLM_URL=http://localhost:11434/v1
# Голос и время слов: сервис speech (Qwen3-TTS + whisper), тоже через туннель.
REELSMITH_SPEECH_URL=http://localhost:8000
# Кто читает текст: chatterbox (живее, сервис voice на 8001) или qwen (сервис speech).
REELSMITH_TTS=chatterbox
REELSMITH_VOICE_URL=http://localhost:8001
# Манера чтения Chatterbox: 0.25 ровно, 0.5 обычно, 0.8 драматично; CFG ниже — медленнее.
CHATTERBOX_EXAGGERATION=0.55
CHATTERBOX_CFG=0.4

# --- Кто что делает ------------------------------------------------------------------
# Планировщик пишет историю целиком, режиссёр ставит каждый бит, кодер пишет код сцены,
# зрение смотрит на кадры и отвечает на вопросы режиссёра. Зрению нужна модель, которая
# понимает картинки.
REELSMITH_PLANNER=qwen3.5:27b
REELSMITH_DIRECTOR=qwen3.5:27b
REELSMITH_CODER=qwen3-coder-next
REELSMITH_VISION=qwen3.5:27b
# Редактор русского текста после планировщика; пусто — без редактора.
REELSMITH_EDITOR=
REELSMITH_TEMPERATURE=0.7
# Рассуждения модели перед ответом: none, low, medium, high. С ними qwen3.5 отвечает
# по три минуты вместо пятнадцати секунд; пусто — как решит сервер моделей.
REELSMITH_REASONING=none
REELSMITH_STAGING=sheet
REELSMITH_CODER_TEMPERATURE=0.3

# --- Что делаем ----------------------------------------------------------------------
REELSMITH_STYLE=blackout
REELSMITH_LANGUAGE=ru
# Сколько раз переписать историю, не прошедшую проверки, и сколько кругов дать сцене,
# прежде чем поставить безопасный вариант.
REELSMITH_REWRITES=2
REELSMITH_ROUNDS=4
# Сколько битов рисовать одновременно; 0 — по числу ядер.
REELSMITH_WORKERS=0
# Меньше этого места на диске (ГБ) — отрисовка не начнётся.
REELSMITH_MIN_FREE_GB=2
