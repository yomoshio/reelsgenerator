POSTGRES_PASSWORD=change-me

# Pin images after the first working build: `make pin` prints the digests to paste here.
OLLAMA_TAG=latest
COMFYUI_REF=v0.43.1

# Models on the local services. The judge model must take images.
REELSMITH_WRITER_MODEL=qwen3.5:27b
REELSMITH_JUDGE_MODEL=qwen3.5:27b
REELSMITH_LANGUAGE=ru
REELSMITH_VOICE=narrator
REELSMITH_WHISPER_MODEL=large-v3-turbo

# Default recipe of new jobs. A job can override it: `add --video wan-5b --hook-video wan-2.2`.
# Video models come from the exported graphs: wan-2.2 (animate.json), wan-5b (animate-draft.json).
REELSMITH_IMAGE_MODEL=z-image
REELSMITH_VIDEO_MODEL=wan-2.2
REELSMITH_HOOK_VIDEO_MODEL=
REELSMITH_HOOK_SHOTS=2

# What an hour of the card costs you. The report turns GPU seconds into dollars with this.
REELSMITH_GPU_HOUR_USD=0.99

REELSMITH_BATCH_SIZE=6
REELSMITH_MAX_ATTEMPTS=5

# Run the conveyor against the real database with no models at all, to check a deployment.
# REELSMITH_SERVICES=synthetic

# Hugging Face is sometimes slow or blocked from Russian networks; a mirror helps.
# HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ENABLE_HF_TRANSFER=1
