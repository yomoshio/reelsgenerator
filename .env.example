# Скопируйте в .env (./run.sh setup делает это сам) и поменяйте то, что нужно.
# Значения ниже настроены на качество, а не на скорость: ролик на 25 шотов идёт около
# полутора-двух часов на RTX 4090. Набор «черновик» для быстрой проверки сюжета описан в docs/settings.md.
# Пустая строка значит «по умолчанию». После правки: docker compose up -d.

POSTGRES_PASSWORD=change-me
OLLAMA_TAG=latest
COMFYUI_REF=v0.43.1

# Сколько стоит час вашей карты. Отчёт переводит GPU-секунды в деньги по этой цене.
REELSMITH_GPU_HOUR_USD=0.99

# --- Что делаем по умолчанию ---------------------------------------------------------
# Стиль: как пишется сценарий и как выглядят кадры, субтитры и плашки. Список: ./run.sh styles.
REELSMITH_STYLE=serial
REELSMITH_LANGUAGE=ru
# Голос диктора: voices/<имя>.wav и voices/<имя>.txt
REELSMITH_VOICE=narrator
# Кадры рисует z-image. Оживляют:
#   wan-2.2-hd  Wan, затем Real-ESRGAN увеличивает клип до 1080x1920 с чёткими краями
#   wan-2.2     та же анимация, клип растягивает ffmpeg; около минуты на клип
#   still       медленный наезд камеры на кадр, ffmpeg на процессоре, секунды на клип
#   wan-5b      есть, если экспортирован workflows/animate-draft.json
# Писатель помечает, движется ли что-то в шоте. Шоты с движением идут в VIDEO_MODEL,
# спокойные в CALM_VIDEO_MODEL. Первые HOOK_SHOTS шотов всегда идут в HOOK_VIDEO_MODEL,
# если он задан. Всё наездом камеры: VIDEO_MODEL=still.
REELSMITH_IMAGE_MODEL=z-image
REELSMITH_VIDEO_MODEL=wan-2.2-hd
# Спокойные шоты (лица, жесты, разговор, вид места) идут наездом камеры по кадру: лица и
# одежда остаются ровно такими, как нарисованы. Wan тратится только на действие. Пусто
# значит Wan оживляет все шоты.
REELSMITH_CALM_VIDEO_MODEL=still
REELSMITH_HOOK_VIDEO_MODEL=
REELSMITH_HOOK_SHOTS=2
# Одинаковые герои: qwen-edit рисует для каждого героя портрет и потом все кадры с ним по
# этому портрету. Нужны веса ./run.sh models character --optional. Пусто значит выключено.
REELSMITH_CAST_IMAGE_MODEL=

# --- Языковая модель (Ollama) --------------------------------------------------------
# Судья смотрит на картинки, поэтому его модель должна понимать изображения.
REELSMITH_WRITER_MODEL=qwen3.5:27b
REELSMITH_JUDGE_MODEL=qwen3.5:27b
# Выше температура, смелее и разнообразнее текст; ниже, строже и предсказуемее.
REELSMITH_WRITER_TEMPERATURE=0.8
REELSMITH_CRITIC_TEMPERATURE=0.2
REELSMITH_JUDGE_TEMPERATURE=0.1
# Ширина стоп-кадров, которые видит судья, и размер контекста модели. Клипы 480 в ширину,
# поэтому 540 хватает. С клипами 720x1280 имеет смысл 1080 и контекст 32768: восемь
# стоп-кадров со сценарием займут около 20 тысяч токенов и больше видеопамяти.
REELSMITH_JUDGE_WIDTH=720
REELSMITH_LLM_CONTEXT=16384

# Наборы «черновик» и «качество» для строк ниже описаны в docs/settings.md.

# --- Кадры (Z-Image Turbo) -----------------------------------------------------------
# Размеры кратны 16. Больше шагов, чуть чище кадр и дольше. Turbo рассчитан на 8.
REELSMITH_FRAME_WIDTH=1088
REELSMITH_FRAME_HEIGHT=1920
REELSMITH_FRAME_STEPS=8
# Шаги Qwen-Image-Edit для кадров с героем по портрету; кадр около 20 секунд.
REELSMITH_EDIT_STEPS=8

# --- Клипы (Wan 2.2 14B) -------------------------------------------------------------
# Самая дорогая часть. 720x1280 вместо 480x848 примерно в 2,5 раза дольше.
# Апскейл клипа 720x1280 по расчёту занимает около 30 ГБ оперативной памяти на время
# клипа. Если на машине с 64 ГБ ComfyUI падает на клипах, поставьте 480x848.
# Шаги делятся пополам между двумя моделями Wan; 4 это минимум для ускоряющих LoRA,
# 6 или 8 дают меньше артефактов и в 1,5-2 раза дольше.
REELSMITH_CLIP_WIDTH=720
REELSMITH_CLIP_HEIGHT=1280
REELSMITH_CLIP_STEPS=8
# Самый длинный клип в секундах; если реплика длиннее, последний кадр держится.
REELSMITH_CLIP_SECONDS=5

# --- Музыка и голос ------------------------------------------------------------------
REELSMITH_MUSIC_STEPS=8
# Громкость музыки под голосом, от 0 до 1.
REELSMITH_MUSIC_LEVEL=0.22
# Выше cfg, ближе к эталонному голосу и меньше живости. Больше шагов, чище и дольше.
REELSMITH_VOICE_CFG=2.0
REELSMITH_VOICE_STEPS=20

# --- Ворота качества -----------------------------------------------------------------
# Оценки судьи от 0 до 10. Ниже порог, меньше переделок и больше брака.
REELSMITH_SCRIPT_PASS=7
REELSMITH_CLIP_PASS=6
# Итоговая оценка ролика только записывается: судья по целому ролику пока бракует почти
# всё, и откат гонял бы переделку всех клипов по кругу.
REELSMITH_QA_PASS=0
# Сколько раз переписать сценарий, сколько кадров-кандидатов на шот,
# сколько раз переделать плохой клип прежде чем оставить как есть.
REELSMITH_REWRITES=3
REELSMITH_CANDIDATES=3
REELSMITH_CLIP_TRIES=3
REELSMITH_VOICE_TRIES=3
# Сколько слов диктор читает одним дублем, сквозь несколько шотов; 0 значит по реплике.
REELSMITH_PASSAGE_WORDS=40

# --- Конвейер ------------------------------------------------------------------------
REELSMITH_BATCH_SIZE=6
# 1 на картах от 80 ГБ (RTX PRO 6000, H100): модели не выгружаются, а кадры и клипы одного
# ролика считаются, пока следующий пишется и озвучивается. Тогда ставьте BATCH_SIZE=1.
# REELSMITH_GPU_SHARED=1
REELSMITH_MAX_ATTEMPTS=5
# synthetic: весь конвейер без моделей, чтобы проверить базу и сборку.
# REELSMITH_SERVICES=synthetic

# Hugging Face бывает медленным из России; зеркало помогает при скачивании весов.
# HF_ENDPOINT=https://hf-mirror.com

# Дополнительные флаги ComfyUI. На машине меньше чем с 64 ГБ памяти ComfyUI держит веса
# всех моделей в RAM, и система убивает его на первом клипе: там нужен --fast-disk.
COMFY_ARGS=

# Арендованный сервер: им управляет ./run.sh server с этого компьютера. На самом сервере
# эти строки ни на что не влияют.
SERVER_HOST=
SERVER_PORT=22
SERVER_KEY=~/.ssh/id_ed25519
SERVER_DIR=/root/reelsmith
# Номер инстанса из карточки аренды vast.ai: по нему autostop удаляет сервер.
VAST_INSTANCE=
